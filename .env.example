# Local development settings only.
DATABASE_URL=postgresql://phone_app:local-app@127.0.0.1:5432/phone
MIGRATION_DATABASE_URL=postgresql://phone_admin:local-admin@127.0.0.1:5432/phone
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
API_PORT=4000
DEMO_PASSWORD=
# Loopback development can preview signup email links. Production uses Resend.
AUTH_LOCAL_VERIFICATION=true
RESEND_API_KEY=
AUTH_FROM_EMAIL=
# Local-only onboarding checkout and fictional number inventory.
ONBOARDING_SANDBOX=true
# Optional real browser voice preview.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Required for live billing and number inventory when onboarding sandbox is disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_ORIGIN=
TWILIO_PROVISIONING_ENABLED=false
TWILIO_REGULATORY_BUNDLE_SID=
TWILIO_ADDRESS_SID=
